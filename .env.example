# Ontology Lifecycle Studio - environment configuration
# Copy to `.env` in the repository root. Every value is optional; defaults are shown.
# Never commit a real `.env` file.

# ----------------------------------------------------------------------------- backend (FastAPI)
# Runtime environment label shown in the health endpoint.
# OLS_ENVIRONMENT=local

# SQLAlchemy database URL. Default: SQLite file at backend/data/ontology_studio.db.
# The models are PostgreSQL-compatible, e.g. postgresql+psycopg://user:password@host:5432/ols
# (requires installing a PostgreSQL driver).
# OLS_DATABASE_URL=sqlite:///C:/path/to/ontology_studio.db

# Apply Alembic migrations automatically on startup (recommended locally; disable in managed envs).
# OLS_AUTO_MIGRATE=true

# Load the Supply Chain demonstration project when the database has no projects.
# OLS_SEED_DEMO_DATA=true

# Allowed browser origins (JSON list). Not needed when using the Vite dev proxy.
# OLS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# OLS_LOG_LEVEL=INFO
# OLS_DATABASE_ECHO=false

# ----------------------------------------------------------------------------- frontend (Vite)
# Backend URL used by the Vite dev-server proxy for /api requests.
# OLS_API_PROXY_TARGET=http://127.0.0.1:8000

# API base path or URL used by the browser. Keep /api when using the dev proxy.
# VITE_API_BASE_URL=/api

# ----------------------------------------------------------------------------- AI discovery (Phase 2)
# Any OpenAI-compatible Chat Completions endpoint. AI discovery is disabled (and nothing is
# fabricated) until both base URL and model are set.
#   Ollama (local):        OLS_LLM_BASE_URL=http://localhost:11434/v1   OLS_LLM_MODEL=qwen2.5:7b
#   OpenAI:                OLS_LLM_BASE_URL=https://api.openai.com/v1    OLS_LLM_MODEL=gpt-4o-mini
#   Azure OpenAI (v1 API): OLS_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# OLS_LLM_BASE_URL=
# OLS_LLM_MODEL=
# Secret - set it in your environment or .env, never commit it.
# OLS_LLM_API_KEY=
# How structured output is requested: json_schema (default) | json_object | prompt
# OLS_LLM_STRUCTURED_OUTPUT=json_schema
# OLS_LLM_TEMPERATURE=0
# Local CPU models can take minutes per batch.
# OLS_LLM_TIMEOUT_SECONDS=600
# OLS_LLM_MAX_OUTPUT_TOKENS=4096
# Re-prompts when the reply does not match the schema.
# OLS_LLM_MAX_REPAIR_ATTEMPTS=1

# Source documents and discovery batching.
# OLS_SOURCE_MAX_UPLOAD_BYTES=10485760
# OLS_DISCOVERY_CHUNK_CHARS=3000
# OLS_DISCOVERY_BATCH_CHARS=6000
# OLS_DISCOVERY_MAX_CHUNKS_PER_RUN=40

# ----------------------------------------------------------------------------- registry (Phase 2)
# Write-once directory for published ontology artifacts (JSON / Turtle). Default: backend/data/artifacts
# OLS_ARTIFACT_DIR=C:/path/to/artifacts

# ----------------------------------------------------------------------------- knowledge graph (Phase 3)
# Maximum records read from one structured (CSV/TSV) source per build.
# OLS_KG_MAX_RECORDS_PER_SOURCE=10000
# Graph persistence uses the built-in SQL adapter (same database). No graph-database settings are
# needed; an Azure Cosmos DB Gremlin adapter would add its endpoint/key settings here.
